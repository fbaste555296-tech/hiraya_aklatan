rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function hasActiveVip() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiry != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiry > request.time;
    }
    
    function isChapterReleased(bookId, chapterId) {
      return exists(/databases/$(database)/documents/books/$(bookId)/chapters/$(chapterId)) &&
             get(/databases/$(database)/documents/books/$(bookId)/chapters/$(chapterId)).data.releaseDate <= request.time;
    }
    
    function isChapterFree(bookId, chapterId) {
      return isChapterReleased(bookId, chapterId) &&
             !get(/databases/$(database)/documents/books/$(bookId)/chapters/$(chapterId)).data.isEarlyAccess;
    }
    
    function hasUnlockedChapter(bookId, chapterId) {
      let unlockId = request.auth.uid + '_' + chapterId;
      let unlockPath = /databases/$(database)/documents/unlockedChapters/$(unlockId);
      return exists(unlockPath) &&
             get(unlockPath).data.userId == request.auth.uid &&
             get(unlockPath).data.bookId == bookId &&
             get(unlockPath).data.chapterId == chapterId &&
             hasApprovedChapterPayment(
               request.auth.uid,
               bookId,
               chapterId,
               get(unlockPath).data.paymentId
             );
    }

    function hasApprovedChapterPayment(userId, bookId, chapterId, paymentId) {
      return exists(/databases/$(database)/documents/payments/$(paymentId)) &&
             get(/databases/$(database)/documents/payments/$(paymentId)).data.userId == userId &&
             get(/databases/$(database)/documents/payments/$(paymentId)).data.type == 'chapter' &&
             get(/databases/$(database)/documents/payments/$(paymentId)).data.targetId == chapterId &&
             get(/databases/$(database)/documents/payments/$(paymentId)).data.bookId == bookId &&
             get(/databases/$(database)/documents/payments/$(paymentId)).data.status == 'approved';
    }

    function isNewRatingAggregate(bookId) {
      let ratingPath = /databases/$(database)/documents/books/$(bookId)/ratings/$(request.auth.uid);
      let oldCount = resource.data.get('ratingCount', 0);
      let newRating = getAfter(ratingPath).data.rating;
      return !exists(ratingPath) &&
             existsAfter(ratingPath) &&
             request.resource.data.ratingCount == oldCount + 1 &&
             request.resource.data.rating ==
               ((resource.data.get('rating', 0) * oldCount + newRating) /
                 request.resource.data.ratingCount);
    }

    function isUpdatedRatingAggregate(bookId) {
      let ratingPath = /databases/$(database)/documents/books/$(bookId)/ratings/$(request.auth.uid);
      let oldCount = resource.data.get('ratingCount', 0);
      let oldRating = get(ratingPath).data.rating;
      let newRating = getAfter(ratingPath).data.rating;
      let effectiveCount = oldCount > 0 ? oldCount : 1;
      let effectiveAverage = oldCount > 0 ? resource.data.get('rating', 0) : oldRating;
      return exists(ratingPath) &&
             existsAfter(ratingPath) &&
             request.resource.data.ratingCount == effectiveCount &&
             request.resource.data.rating ==
               ((effectiveAverage * effectiveCount - oldRating + newRating) /
                 request.resource.data.ratingCount);
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
                      request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
                      request.resource.data.role == 'reader' &&
                      request.resource.data.vipExpiry == null;
      allow update: if (isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'vipExpiry'])) ||
                      isAdmin();
      allow delete: if isAdmin();
    }
    
    // Books collection
    match /books/{bookId} {
      allow read: if true; // Public read access
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['rating', 'ratingCount']) &&
         request.resource.data.rating is number &&
         request.resource.data.rating >= 0 &&
         request.resource.data.rating <= 5 &&
         request.resource.data.ratingCount is int &&
         request.resource.data.ratingCount > 0 &&
         (isNewRatingAggregate(bookId) ||
          isUpdatedRatingAggregate(bookId)));

      match /ratings/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['userId', 'rating', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['userId', 'rating', 'updatedAt']) &&
          request.resource.data.userId == userId &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }

      // Chapters subcollection
      match /chapters/{chapterId} {
        allow read: if true; // Metadata is public
        allow write: if isAdmin();
      }
    }
    
    // Chapter contents (LOCKED content)
    match /chapterContents/{chapterId} {
      allow read: if isAdmin() || 
                    isChapterFree(resource.data.bookId, chapterId) ||
                    (hasActiveVip() && isChapterReleased(resource.data.bookId, chapterId)) ||
                    hasUnlockedChapter(resource.data.bookId, chapterId);
      allow write: if isAdmin();
    }
    
    // Unlocked chapters
    match /unlockedChapters/{unlockId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin() ||
                    (isOwner(request.resource.data.userId) &&
                     unlockId == request.resource.data.userId + '_' + request.resource.data.chapterId &&
                     exists(/databases/$(database)/documents/books/$(request.resource.data.bookId)/chapters/$(request.resource.data.chapterId)) &&
                     hasApprovedChapterPayment(
                       request.resource.data.userId,
                       request.resource.data.bookId,
                       request.resource.data.chapterId,
                       request.resource.data.paymentId
                     ));
      allow update, delete: if isAdmin();
    }
    
    // Payments
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && 
                      isOwner(request.resource.data.userId) &&
                      request.resource.data.status == 'pending';
      allow update: if isAdmin(); // Only admins can approve/reject
      allow delete: if isAdmin();
    }
    
    // User libraries (reading progress)
    match /libraries/{userId} {
      allow read, write: if isOwner(userId);
      
      match /books/{bookId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // App settings
    match /settings/app {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}